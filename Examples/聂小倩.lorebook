    {
      "id": "yan",
      "title": "燕赤霞",
      "content": "燕赤霞与宁采臣同宿古寺，外表像书生，对夜间怪异有所戒备。",
      "keys": [
        "燕赤霞"
      ]
    },
    {
      "id": "temple",
      "title": "金华古寺",
      "content": "古寺荒凉，殿宇壮丽，庭院草木繁茂。夜深之后，寺中传来低语。",
      "keys": [
        "古寺",
        "金华"
      ]
    },
